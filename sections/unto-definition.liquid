{%- comment -%} Unto: what the name means. The eyes look around; the wordmark is the logo file. {%- endcomment -%}
<div class="u-block u-combo-{{ section.settings.combo }} u-def">
  <div class="u-wrap u-stack u-center">
    <div class="u-def__eyes" data-unto-eyes aria-hidden="true">
      <span style="--u-mask: url('{{ 'unto-eyes-outline.svg' | asset_url }}');"></span>
      <span class="u-def__pupils" style="--u-mask: url('{{ 'unto-eyes-pupils.svg' | asset_url }}');"></span>
    </div>
    <h2 class="u-wordmark" style="--u-mask: url('{{ 'unto-wordmark.svg' | asset_url }}');"><span class="visually-hidden">UNTO</span></h2>
    <div class="u-def__entry">
      {%- if section.settings.grammar != blank -%}<p class="u-label">{{ section.settings.grammar | escape }}</p>{%- endif -%}
      <ol class="u-def__list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Unto definition",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "select", "id": "combo", "label": "Colours", "default": "sunflower", "options": [
        { "value": "neon", "label": "Neon oil + green" },
        { "value": "green", "label": "Green + white" },
        { "value": "olive-red", "label": "Olive red + leaf" },
        { "value": "sky", "label": "Sky + green" },
        { "value": "sunflower", "label": "Sunflower + earth" },
        { "value": "sand", "label": "Sand + green" },
        { "value": "heat", "label": "Heat + olive red" },
        { "value": "leaf", "label": "Leaf + olive red" },
        { "value": "paper", "label": "Paper + green" }
      ] },
    { "type": "text", "id": "grammar", "label": "Small line", "default": "(oon-toh) adjective, Italian:" }
  ],
  "blocks": [
    { "type": "meaning", "name": "Meaning", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Oily. Greasy. Dressed." } ] }
  ],
  "presets": [{ "name": "Unto definition" }]
}
{% endschema %}
