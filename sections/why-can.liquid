{%- comment -%} Unto: why this harvest comes in a tin. One giant word per reason. {%- endcomment -%}
<div class="u-block u-combo-{{ section.settings.combo }} u-why">
  <div class="u-wrap u-stack u-center">
    {%- if section.settings.label != blank -%}<p class="u-label">{{ section.settings.label | escape }}</p>{%- endif -%}
    {%- if section.settings.intro != blank -%}<p class="u-statement">{{ section.settings.intro | escape }}</p>{%- endif -%}
    <ul class="u-why__list" role="list">
      {%- for block in section.blocks -%}
        <li class="u-why__item" {{ block.shopify_attributes }}>
          <span class="u-display u-fit" style="--n: {{ block.settings.word | size }};" data-max="150" aria-hidden="true">{{ block.settings.word | escape }}</span>
          <p class="u-copy"><span class="visually-hidden">{{ block.settings.word | escape }}: </span>{{ block.settings.text | escape }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Why a tin",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "select", "id": "combo", "label": "Colours", "default": "sky", "options": [
        { "value": "neon", "label": "Neon oil + green" },
        { "value": "green", "label": "Green + white" },
        { "value": "olive-red", "label": "Olive red + leaf" },
        { "value": "sky", "label": "Sky + green" },
        { "value": "sunflower", "label": "Sunflower + earth" },
        { "value": "sand", "label": "Sand + green" },
        { "value": "heat", "label": "Heat + olive red" },
        { "value": "leaf", "label": "Leaf + olive red" },
        { "value": "paper", "label": "Paper + green" }
      ] },
    { "type": "text", "id": "label", "label": "Label", "default": "Why a tin:" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "This harvest comes in a 250ml tin only." }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Reason",
      "settings": [
        { "type": "text", "id": "word", "label": "Big word", "default": "Light" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Why a tin" }]
}
{% endschema %}
