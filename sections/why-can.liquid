{%- comment -%} Unto 2026: why this harvest comes in a can. {%- endcomment -%}
<div class="unto-why color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width unto-why__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="unto-why__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <p class="unto-why__intro">{{ section.settings.intro | escape }}</p>
    {%- endif -%}
    <ul class="unto-why__list" role="list">
      {%- for block in section.blocks -%}
        <li class="unto-why__item" {{ block.shopify_attributes }}>
          <p class="unto-why__title">{{ block.settings.title | escape }}</p>
          <p class="unto-why__text">{{ block.settings.text | escape }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Why a can",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why a can this year" },
    { "type": "text", "id": "intro", "label": "Intro", "default": "This harvest comes in a 250ml tin only." },
    {
      "type": "select", "id": "color_scheme", "label": "Color scheme", "default": "background-1",
      "options": [
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "inverse", "label": "Inverse" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Lighter to ship" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why a can",
      "blocks": [
        { "type": "point", "settings": { "title": "Lighter to ship", "text": "A tin weighs a fraction of a glass bottle, so it costs less to send and doesn't break in the post." } },
        { "type": "point", "settings": { "title": "Keeps the light out", "text": "Light is what spoils olive oil. The tin keeps it dark, so the oil stays fresh for longer." } },
        { "type": "point", "settings": { "title": "100% recyclable", "text": "Steel tins can be recycled again and again. Rinse it and put it in your household recycling." } }
      ]
    }
  ]
}
{% endschema %}
