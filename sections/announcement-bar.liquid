{%- comment -%} Unto 2026: the announcement bar is a ticker. Each block is one item. {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  {%- assign first = section.blocks.first -%}
  <div class="u-ticker" role="region" aria-label="{{ 'sections.header.announcement' | t }}">
    {%- if first.settings.link != blank -%}<a class="u-ticker__link" href="{{ first.settings.link }}">{%- endif -%}
    <div class="u-ticker__track">
      {%- for i in (1..4) -%}
        <div class="u-ticker__group"{% unless forloop.first %} aria-hidden="true"{% endunless %}>
          {%- for block in section.blocks -%}
            <span class="u-ticker__item"{% if i == 1 %} {{ block.shopify_attributes }}{% endif %}>{{ block.settings.text | escape }}</span>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if first.settings.link != blank -%}</a>{%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        { "type": "text", "id": "text", "default": "Welcome to our store", "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label" },
        { "type": "text", "id": "text_alignment", "label": "Unused", "default": "center" },
        { "type": "text", "id": "color_scheme", "label": "Unused", "default": "accent-1" },
        { "type": "url", "id": "link", "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label" }
      ]
    }
  ],
  "default": { "blocks": [ { "type": "announcement" } ] }
}
{% endschema %}
