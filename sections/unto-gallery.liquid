{%- comment -%} Unto: ways to use it. Swipeable on phones, a row on desktop. {%- endcomment -%}
<div class="u-block u-combo-{{ section.settings.combo }} u-uses">
  <div class="u-stack u-center">
    <div class="u-wrap u-stack u-center">
      {%- if section.settings.label != blank -%}<p class="u-label">{{ section.settings.label | escape }}</p>{%- endif -%}
      {%- if section.settings.word != blank -%}
        <h2 class="u-display u-fit" style="--n: {{ section.settings.word | size }};" data-max="220">{{ section.settings.word | escape }}</h2>
      {%- endif -%}
    </div>
    <ul class="u-uses__list" role="list">
      {%- for block in section.blocks -%}
        <li class="u-uses__item" {{ block.shopify_attributes }}>
          {%- render 'unto-img', image: block.settings.picked, asset: block.settings.image, alt: block.settings.alt, sizes: '(min-width: 750px) 25vw, 76vw', position: block.settings.focus -%}
          {%- if block.settings.caption != blank -%}<p class="u-uses__cap">{{ block.settings.caption | escape }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Unto ways to use",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "select", "id": "combo", "label": "Colours", "default": "paper", "options": [
        { "value": "neon", "label": "Neon oil + green" },
        { "value": "green", "label": "Green + white" },
        { "value": "olive-red", "label": "Olive red + leaf" },
        { "value": "sky", "label": "Sky + green" },
        { "value": "sunflower", "label": "Sunflower + earth" },
        { "value": "sand", "label": "Sand + green" },
        { "value": "heat", "label": "Heat + olive red" },
        { "value": "leaf", "label": "Leaf + olive red" },
        { "value": "paper", "label": "Paper + green" }
      ] },
    { "type": "text", "id": "label", "label": "Label", "default": "Try this at home:" },
    { "type": "text", "id": "word", "label": "Big word", "default": "Pour" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "picked", "label": "Image" },
        { "type": "text", "id": "image", "label": "Or theme asset file name" },
        { "type": "text", "id": "alt", "label": "Image description" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "text", "id": "focus", "label": "Focus (CSS object-position)", "default": "center" }
      ]
    }
  ],
  "presets": [{ "name": "Unto ways to use" }]
}
{% endschema %}
