{%- comment -%}
  Unto 2026: photo strip. Swipeable row on phones, grid on desktop.
  Images are theme assets; "focus" sets which part of the photo stays in frame.
{%- endcomment -%}
<div class="unto-gallery color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width unto-gallery__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="unto-gallery__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="unto-gallery__list" role="list">
      {%- for block in section.blocks -%}
        {%- if block.settings.image != blank -%}
          <li class="unto-gallery__item" {{ block.shopify_attributes }}>
            <img
              src="{{ block.settings.image | asset_img_url: '800x' }}"
              srcset="{{ block.settings.image | asset_img_url: '500x' }} 500w, {{ block.settings.image | asset_img_url: '800x' }} 800w, {{ block.settings.image | asset_img_url: '1200x' }} 1200w"
              sizes="(min-width: 750px) 30vw, 78vw"
              width="1200"
              height="1600"
              loading="lazy"
              alt="{{ block.settings.alt | escape }}"
              style="object-position: {{ block.settings.focus | default: 'center' }};"
            >
            {%- if block.settings.caption != blank -%}
              <p class="unto-gallery__caption">{{ block.settings.caption | escape }}</p>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Unto photo strip",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "At the table" },
    {
      "type": "select", "id": "color_scheme", "label": "Color scheme", "default": "background-1",
      "options": [
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "inverse", "label": "Inverse" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "text", "id": "image", "label": "Theme asset file name" },
        { "type": "text", "id": "alt", "label": "Image description" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "text", "id": "focus", "label": "Focus (CSS object-position)", "default": "center" }
      ]
    }
  ],
  "presets": [{ "name": "Unto photo strip" }]
}
{% endschema %}
