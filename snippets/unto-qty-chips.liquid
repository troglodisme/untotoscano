{%- comment -%}
  Unto: quantity tiles ("1 tin / 2 tins / 3 tins") that drive the standard
  quantity input. Captions and badges come from Theme settings > Unto 2026.
  Params: product, section_id
{%- endcomment -%}
{%- if product.has_only_default_variant or product.variants.size == 1 -%}
  {%- assign v = product.selected_or_first_available_variant -%}
  <fieldset class="u-chips" data-section="{{ section_id }}">
    <legend>How many?</legend>
    {%- for n in (1..3) -%}
      {%- liquid
        assign total = v.price | times: n | money
        case n
          when 1
            assign cap = settings.unto_chip_1
            assign badge = ''
          when 2
            assign cap = settings.unto_chip_2
            assign badge = settings.unto_chip_2_badge
          when 3
            assign cap = settings.unto_chip_3
            assign badge = settings.unto_chip_3_badge
        endcase
      -%}
      <label class="u-chip" data-total="{{ total }}">
        <input type="radio" name="unto-qty-{{ section_id }}" value="{{ n }}"{% if n == 1 %} checked{% endif %}>
        <span class="u-chip__n" aria-hidden="true">{{ n }}</span>
        <span class="u-chip__t"><b>{{ n }} {% if n == 1 %}tin{% else %}tins{% endif %}</b>{% if cap != blank %}<span>{{ cap | escape }}</span>{% endif %}</span>
        <span class="u-chip__p">{{ total }}{% if badge != blank %}<span class="u-chip__badge">{{ badge | escape }}</span>{% endif %}</span>
      </label>
    {%- endfor -%}
  </fieldset>
{%- endif -%}
