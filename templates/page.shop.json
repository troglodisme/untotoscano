m":36}},"3d656739-9519-4eab-bba4-6291252efab4":{"type":"image-with-text","blocks":{"template--16000293273787__3d656739-9519-4eab-bba4-6291252efab4-166991341150345462-0":{"type":"heading","settings":{"heading":"Interested to stock UNTO?","heading_size":"h2"}},"template--16000293273787__3d656739-9519-4eab-bba4-6291252efab4-166991341150345462-1":{"type":"text","settings":{"text":"<p>If you are interested in becoming one of our selected stockists, please get in touch and we'll get back to you as soon as possible.</p>","text_style":"body"}},"template--16000293273787__3d656739-9519-4eab-bba4-6291252efab4-166991341150345462-2":{"type":"button","settings":{"button_label":"Get in touch","button_link":"shopify://pages/get-in-touch"}}},"block_order":["template--16000293273787__3d656739-9519-4eab-bba4-6291252efab4-166991341150345462-0","template--16000293273787__3d656739-9519-4eab-bba4-6291252efab4-166991341150345462-1","template--16000293273787__3d656739-9519-4eab-bba4-6291252efab4-166991341150345462-2"],"settings":{"image":"shopify://shop_images/1394_Unto_Toscano_-_Shot_by_tomcockram_for_delli.market.jpg","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","color_scheme":"background-1","mobile_content_alignment":"left","padding_top":36,"padding_bottom":36}},"why_can":{"type":"why-can","blocks":{"point-1":{"type":"point","settings":{"word":"Light","text":"A tin weighs far less than a glass bottle, so it costs less to post and won't break on the way."}},"point-2":{"type":"point","settings":{"word":"Dark","text":"Light is what spoils olive oil. Inside a tin it's always dark, so the oil stays fresh for longer."}},"point-3":{"type":"point","settings":{"word":"Again","text":"Steel recycles again and again. Rinse the tin and put it in your household recycling."}}},"block_order":["point-1","point-2","point-3"],"settings":{"combo":"sky","label":"Why a tin:","intro":"This harvest comes in a 250ml tin only."}},"unto_faq":{"type":"unto-faq","blocks":{"qa-1":{"type":"qa","settings":{"q":"When will it arrive?","a":"<p>We ship across the UK. Order by 16 December for delivery before Christmas.</p><p>The details are on our <a href=\"/policies/shipping-policy\">shipping page</a>.</p>"}},"qa-2":{"type":"qa","settings":{"q":"Can I send it as a gift?","a":"<p>Yes. Add a gift message in your cart and enter their address at checkout.</p><p>Sending to several people? Place one order per address.</p>"}},"qa-3":{"type":"qa","settings":{"q":"What do I do with it?","a":"<p>Pour it on things. Warm bread, beans, soup, roast potatoes, a fried egg. Add it at the end, off the heat.</p>"}},"qa-4":{"type":"qa","settings":{"q":"What does it taste like?","a":"<p>New-season Tuscan oil is green and grassy, with a peppery kick at the back of the throat. The pepper is a sign of fresh oil, and it softens over the months.</p>"}},"qa-5":{"type":"qa","settings":{"q":"How long does it keep?","a":"<p>The best-before date is printed on the tin. Keep it somewhere cool and dark. It's at its best young, so don't save it for a special occasion.</p>"}},"qa-6":{"type":"qa","settings":{"q":"Where does the oil come from?","a":"<p>From a small farm in the hills around Florence. UNTO started as a project to bring neglected Tuscan land back into use. <a href=\"/pages/our-story-long-version\">Read the story</a>.</p>"}},"qa-0":{"type":"qa","settings":{"q":"What is olio nuovo?","a":"<p>Italian for new oil: the first oil of the season, pressed in autumn, at its greenest and most peppery. In Tuscany people wait all year for it.</p>"}}},"block_order":["qa-0","qa-1","qa-2","qa-3","qa-4","qa-5","qa-6"],"settings":{"combo":"paper","label":"Something you should know:"}},"unto_last":{"type":"unto-last-orders","settings":{"combo":"heat","label":"Wednesday 16 December:","words":"Last\norders","repeat":2,"text":"","after":"Christmas orders have closed. New orders ship as normal.","button_label":"Shop the tin","button_link":""}}},"order":["main","26b38d96-8ce8-4fcd-bf04-cef0140b98dc","f0e70909-8b2f-4cf5-9e24-4069dd2ef767","why_can","unto_faq","unto_last","3d656739-9519-4eab-bba4-6291252efab4"]}